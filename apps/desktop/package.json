{
  "name": "@editools/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Editools desktop app — your editing toolbox",
  "author": "Igor Costa",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:electron --external:onnxruntime-node --external:onnxruntime-common --outfile=dist/main.cjs",
    "typecheck": "tsc"
  },
  "build": {
    "appId": "com.editools.desktop",
    "electronVersion": "44.3.0",
    "productName": "Editools",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../node_modules/youtube-dl-exec/bin/yt-dlp.exe",
        "to": "bin/yt-dlp.exe"
      },
      {
        "from": "../../node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "../../vendor/realesrgan",
        "to": "bin/realesrgan"
      },
      {
        "from": "../../vendor/models",
        "to": "models"
      },
      {
        "from": "../../node_modules/onnxruntime-node",
        "to": "node_modules/onnxruntime-node",
        "filter": [
          "package.json",
          "dist/**",
          "lib/**",
          "bin/napi-v6/win32/x64/**"
        ]
      },
      {
        "from": "../../node_modules/onnxruntime-common",
        "to": "node_modules/onnxruntime-common",
        "filter": [
          "package.json",
          "dist/**",
          "lib/**"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  }
}
