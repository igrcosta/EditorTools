{
  "name": "@editools/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Editools desktop app — your editing toolbox",
  "author": "Igor Costa",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main.cjs",
    "typecheck": "tsc"
  },
  "build": {
    "appId": "com.editools.desktop",
    "electronVersion": "44.3.0",
    "productName": "Editools",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../node_modules/youtube-dl-exec/bin/yt-dlp.exe",
        "to": "bin/yt-dlp.exe"
      },
      {
        "from": "../../node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  }
}
